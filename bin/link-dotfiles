#!/usr/bin/env bash

set -euo pipefail

REPO="$(cd "$(dirname "$(realpath "$0")")/../" && pwd)"

symlink() {
    local filename="$1"
    local dst="$2"

    local src="${REPO}/${filename}"

    if [[ -L "$dst" && "$dst" -ef "$src" ]]; then
        echo "No update to $filename"
        return
    fi

    if [[ ! -d "$(dirname "$dst")" ]]; then
        mkdir -pv "$(dirname "$dst")"
    fi

    # ln cannot unlink a real directory, and without -h it links inside the directory instead
    if [[ -d "$dst" && ! -L "$dst" ]]; then
        rm -ri "$dst"
        # rm -ri exits 0 even when declined, so confirm the directory is actually gone
        if [[ -e "$dst" ]]; then
            echo "Skipping $filename"
            return
        fi
    fi

    # A declined prompt exits non-zero; skip that link rather than aborting the run
    if ! ln -shvi "$src" "$dst"; then
        echo "Skipping $filename"
    fi
}

merge_settings() {
    local src="$1"
    local dst="$2"

    # Convert existing symlink to a standalone file so machine-local edits don't affect dotfiles
    if [[ -L "$dst" ]]; then
        local content
        content=$(jq '.permissions.allow = (.permissions.allow // [] | unique) | .permissions.deny = (.permissions.deny // [] | unique)' "$dst")
        rm "$dst"
        printf '%s\n' "$content" > "$dst"
        echo "Converted settings.json symlink to standalone file"
        return
    fi

    if [[ ! -f "$dst" ]]; then
        jq '.permissions.allow = (.permissions.allow // [] | unique) | .permissions.deny = (.permissions.deny // [] | unique)' "$src" > "$dst"
        echo "Created settings.json from dotfiles defaults"
        return
    fi

    # Deep merge: dotfiles is base, machine-local wins for scalar/object conflicts.
    # permissions.allow and permissions.deny are unioned so dotfiles entries are always present.
    local merged existing
    merged=$(jq -s '
        .[0] as $base | .[1] as $override |
        (($base.permissions.allow // []) + ($override.permissions.allow // []) | unique) as $allow |
        (($base.permissions.deny // []) + ($override.permissions.deny // []) | unique) as $deny |
        $base * $override |
        .permissions.allow = $allow |
        .permissions.deny = $deny
    ' "$src" "$dst")
    existing=$(jq '.' "$dst")

    if [[ "$merged" == "$existing" ]]; then
        echo "No update to settings.json"
    else
        printf '%s\n' "$merged" > "$dst"
        echo "Merged settings.json"
    fi
}

symlink bin "${HOME}/.bin"
symlink config "${HOME}/.config"
symlink config/hammerspoon "${HOME}/.hammerspoon"
symlink claude/CLAUDE.md "${HOME}/.claude/CLAUDE.md"
symlink claude/skills "${HOME}/.claude/skills"
symlink claude/statusline-command.fish "${HOME}/.claude/statusline-command.fish"

merge_settings "${REPO}/claude/settings.json" "${HOME}/.claude/settings.json"
