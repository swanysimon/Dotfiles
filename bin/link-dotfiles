#!/usr/bin/env fish

set -g REPO (path dirname (path dirname (path resolve (status filename))))

function symlink --argument-names filename dst
    set -l src $REPO/$filename

    if test -L $dst; and test (path resolve $dst) = (path resolve $src)
        echo "No update to $filename"
        return
    end

    if not test -d (path dirname $dst)
        mkdir -pv (path dirname $dst)
    end

    # ln cannot unlink a real directory, and without -h it links inside the directory instead
    if test -d $dst; and not test -L $dst
        rm -ri $dst
        # rm -ri exits 0 even when declined, so confirm the directory is actually gone
        if test -e $dst
            echo "Skipping $filename"
            return
        end
    end

    # A declined prompt exits non-zero; skip that link rather than aborting the run
    ln -shvi $src $dst; or echo "Skipping $filename"
end

# Copied rather than linked so private config can overwrite it without writing into this repo
function install_file --argument-names filename dst
    set -l src $REPO/$filename

    if test -f $dst; and not test -L $dst; and cmp -s $src $dst
        echo "No update to $filename"
        return
    end

    rm -f $dst
    cp -v $src $dst
end

# Merge dotfiles defaults into a live settings file.
#   normalize: jq program applied when converting a symlink or seeding a new file
#   merge: jq -s program where .[0] is dotfiles (base) and .[1] is the live file (override)
function merge_json_settings --argument-names src dst normalize merge
    # Convert existing symlink to a standalone file so machine-local edits don't affect dotfiles
    if test -L $dst
        set -l content (jq $normalize $dst | string collect); or return
        rm $dst
        printf '%s\n' $content >$dst
        echo "Converted $dst symlink to standalone file"
        return
    end

    if not test -f $dst
        jq $normalize $src >$dst; or return
        echo "Created $dst from dotfiles defaults"
        return
    end

    set -l merged (jq -s $merge $src $dst | string collect); or return
    set -l existing (jq . $dst | string collect); or return

    if test "$merged" = "$existing"
        echo "No update to $dst"
    else
        printf '%s\n' $merged >$dst
        echo "Merged $dst"
    end
end

# Claude: dedupe permission lists when seeding/converting
set -l claude_normalize '.permissions.allow = (.permissions.allow // [] | unique) | .permissions.deny = (.permissions.deny // [] | unique)'

# Claude: deep merge with machine-local winning, except permissions.allow/deny which are
# unioned so dotfiles entries are always present
set -l claude_merge '
    .[0] as $base | .[1] as $override |
    (($base.permissions.allow // []) + ($override.permissions.allow // []) | unique) as $allow |
    (($base.permissions.deny // []) + ($override.permissions.deny // []) | unique) as $deny |
    $base * $override |
    .permissions.allow = $allow |
    .permissions.deny = $deny
'

# Pi: plain deep merge, machine-local wins (pi-managed keys like lastChangelogVersion survive)
set -l pi_merge '.[0] * .[1]'

symlink bin ~/.bin
symlink config ~/.config
symlink config/hammerspoon ~/.hammerspoon
symlink config/nvim/ideavimrc ~/.ideavimrc

# Agent-neutral: AGENTS.md as each tool's global instructions, skills in the Agent Skills location
symlink agents/AGENTS.md ~/.claude/CLAUDE.md
symlink agents/AGENTS.md ~/.pi/agent/AGENTS.md
symlink agents/skills ~/.agents/skills
symlink agents/skills ~/.claude/skills
symlink agents/agents ~/.claude/agents

symlink agents/claude/statusline-command.fish ~/.claude/statusline-command.fish
symlink agents/pi/extensions/tiers.ts ~/.pi/agent/extensions/tiers.ts
install_file agents/pi/tiers.json ~/.pi/agent/tiers.json

merge_json_settings $REPO/agents/claude/settings.json ~/.claude/settings.json $claude_normalize $claude_merge
merge_json_settings $REPO/agents/pi/settings.json ~/.pi/agent/settings.json . $pi_merge

# Private machine config (e.g. work-dotfiles) hooks in by defining _link_dotfiles in the per-host fish config
if functions -q _link_dotfiles
    _link_dotfiles
end
